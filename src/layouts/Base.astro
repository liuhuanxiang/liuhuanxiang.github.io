---
import '../styles/global.css';
interface Props { title?: string; description?: string; active?: string; }
const { title, description = 'Java 后端开发者的工程手记。记录实践、AI 探索，以及把问题弄明白的过程。', active = '' } = Astro.props;
const siteName = 'HX 的工程手记';
const pageTitle = title ? `${title} · ${siteName}` : siteName;
const canonical = new URL(Astro.url.pathname, Astro.site);
const navigation = [ ['/', '首页', 'home'], ['/articles/', '文章', 'articles'], ['/projects/', '项目', 'projects'], ['/about/', '关于', 'about'] ];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f7f8f2" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <script is:inline>
      try {
        const saved = localStorage.getItem('hx-theme');
        const theme = saved === 'dark' || saved === 'light' ? saved : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;
      } catch (_) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="HX 的工程手记，首页">
          <span class="brand-mark" aria-hidden="true">hx<span>.</span></span>
          <span class="brand-copy"><strong>HX 的工程手记</strong><small>NOTES ON BUILDING</small></span>
        </a>
        <div class="header-actions">
          <nav class="site-nav" aria-label="主导航">
            {navigation.map(([href, label, id]) => <a href={href} aria-current={active === id ? 'page' : undefined}>{label}</a>)}
          </nav>
          <button class="theme-toggle" type="button" data-theme-toggle hidden aria-label="切换深浅主题">
            <svg class="moon-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20.7 13.1A8.8 8.8 0 0 1 10.9 3.3a8.8 8.8 0 1 0 9.8 9.8Z" /></svg>
            <svg class="sun-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" /></svg>
          </button>
        </div>
      </div>
    </header>
    <main id="main" class="container"><slot /></main>
    <footer class="site-footer container">
      <div><a class="footer-brand" href="/">HX 的工程手记<span aria-hidden="true">.</span></a><p>写给未来的自己，也写给遇到同样问题的人。</p></div>
      <div class="footer-right"><nav aria-label="页脚导航"><a href="https://github.com/liuhuanxiang" target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href="/rss.xml">RSS 订阅</a></nav><small>© {new Date().getFullYear()} liuhx · 保留过程，持续积累</small></div>
    </footer>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
