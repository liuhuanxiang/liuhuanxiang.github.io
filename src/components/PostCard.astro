---
import { formatDate, isoDate, postUrl, readingMinutes, type Post } from '../lib/posts';
interface Props { post: Post; featured?: boolean; }
const { post, featured = false } = Astro.props;
---
<article class:list={['post-card', { 'post-featured': featured }]} data-post-card data-category={post.data.category} data-search={`${post.data.title} ${post.data.description} ${post.data.tags.join(' ')} ${post.data.category}`.toLowerCase()}>
  <div class="post-meta"><span class="category-label">{post.data.category}</span><time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time><span>约 {readingMinutes(post.body)} 分钟</span></div>
  <h3><a href={postUrl(post)}>{post.data.title}</a></h3>
  <p>{post.data.description}</p>
  <div class="post-bottom"><div class="tags">{post.data.tags.map((tag) => <span>#{tag}</span>)}</div><a class="read-link" href={postUrl(post)} aria-label={`阅读全文：${post.data.title}`}>阅读全文 <span aria-hidden="true">↗</span></a></div>
</article>
