---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { publishedPosts, postUrl, formatDate, isoDate, readingMinutes, type Post } from '../lib/posts';
export async function getStaticPaths() {
  return (await publishedPosts()).map((post) => ({ params: { slug: postUrl(post).replace(/^\/|\/$/g, '') }, props: { post } }));
}
interface Props { post: Post; }
const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---
<Base title={post.data.title} description={post.data.description} active="articles">
  <article class="post-page"><a class="back-link" href="/articles/">← 全部文章</a><header class="post-heading"><div class="post-meta"><span class="category-label">{post.data.category}</span><time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time><span>约 {readingMinutes(post.body)} 分钟</span></div><h1>{post.data.title}</h1><p>{post.data.description}</p><div class="tags">{post.data.tags.map((tag) => <span>#{tag}</span>)}</div></header>
    <div class="post-grid"><div><div class="prose"><Content /></div>{post.data.assistance && <p class="editorial-note">内容说明：{post.data.assistance}</p>}<footer class="article-end"><span>记录到这里，思考还在继续。</span><a class="text-link" href="/articles/">其他文章 →</a></footer></div>{toc.length > 0 && <aside class="table-of-contents"><nav aria-label="文章目录"><span>本文目录</span><ol>{toc.map((heading) => <li class:list={{ 'toc-sub': heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></nav></aside>}</div>
  </article>
</Base>
